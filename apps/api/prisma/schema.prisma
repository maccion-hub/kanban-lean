generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImportStatus {
  UPLOADED
  MAPPING_INFERRED
  NORMALIZED
  FAILED
}

enum ProposalStatus {
  DRAFT
  GENERATED
  APPROVED
  ARCHIVED
}

enum KanbanControlType {
  PHYSICAL_SIMPLE
  VALIDATION_REQUIRED
  COST_ZERO_EXCEPTION
}

model AppSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ImportBatch {
  id                String       @id @default(uuid())
  originalName      String
  fileHash          String
  sheetName         String?
  status            ImportStatus @default(UPLOADED)
  mappingJson       Json?
  headersJson       Json?
  rawRowsJson       Json?
  importOptionsJson Json?
  rowCount          Int          @default(0)
  errorMessage      String?
  createdAt         DateTime     @default(now())
  articleMetrics    ArticleMetric[]
  proposals         KanbanProposal[]
}

model Article {
  id              String              @id @default(uuid())
  code            String              @unique
  description     String
  unitCost        Decimal             @db.Decimal(12, 4)
  isCostException Boolean             @default(false)
  currentStock    Decimal?            @db.Decimal(12, 3)
  packaging       String?
  lastImportId    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  metrics         ArticleMetric[]
  proposalItems   KanbanProposalItem[]
}

model ArticleMetric {
  id                 String    @id @default(uuid())
  articleId          String
  importBatchId      String
  periodStart        DateTime?
  periodEnd          DateTime?
  periodWorkingDays  Int?
  totalConsumption   Decimal?  @db.Decimal(14, 3)
  annualRotation     Decimal?  @db.Decimal(14, 3)
  avgDailyDemand     Decimal   @db.Decimal(14, 6)
  sourceRowNumber    Int?
  createdAt          DateTime  @default(now())
  article            Article     @relation(fields: [articleId], references: [id])
  importBatch        ImportBatch @relation(fields: [importBatchId], references: [id])

  @@index([importBatchId])
  @@index([articleId])
}

model KanbanConfig {
  id                     String   @id @default(uuid())
  name                   String
  isDefault              Boolean  @default(false)
  workingDaysPerYear     Int      @default(220)
  leadTimeDays           Int      @default(2)
  safetyStockDays        Int      @default(5)
  lowCostMax             Decimal  @default(1.0000) @db.Decimal(12, 4)
  mediumCostMax          Decimal  @default(10.0000) @db.Decimal(12, 4)
  lowCostLotDays         Int      @default(20)
  mediumCostLotDays      Int      @default(15)
  highCostLotDays        Int      @default(10)
  validationUnitCostMin  Decimal  @default(50.0000) @db.Decimal(12, 4)
  validationKmaxValueMin Decimal  @default(300.0000) @db.Decimal(12, 4)
  roundingJson           Json
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  proposals              KanbanProposal[]
}

model KanbanProposal {
  id             String         @id @default(uuid())
  versionNumber  Int
  name           String
  status         ProposalStatus @default(GENERATED)
  sourceImportId String?
  configId       String?
  sourceHash     String
  configSnapshot Json
  summaryJson    Json
  createdAt      DateTime       @default(now())
  sourceImport   ImportBatch?   @relation(fields: [sourceImportId], references: [id])
  config         KanbanConfig?  @relation(fields: [configId], references: [id])
  items          KanbanProposalItem[]

  @@unique([sourceHash])
}

model KanbanProposalItem {
  id                String            @id @default(uuid())
  proposalId        String
  articleId         String
  code              String
  description       String
  unitCost          Decimal           @db.Decimal(12, 4)
  avgDailyDemand    Decimal           @db.Decimal(14, 6)
  sourceType        String?
  sourceValue       Decimal?          @db.Decimal(14, 3)
  sourceDays        Int?
  kminRaw           Decimal           @db.Decimal(14, 3)
  klotRaw           Decimal           @db.Decimal(14, 3)
  kmin              Int
  klot              Int
  kmax              Int
  lotCoverageDays   Int
  valueAtKmin       Decimal           @db.Decimal(14, 2)
  valueAtKmax       Decimal           @db.Decimal(14, 2)
  averageStockUnits Decimal           @db.Decimal(14, 3)
  averageStockValue Decimal           @db.Decimal(14, 2)
  controlType       KanbanControlType
  rationale         String
  diffJson          Json?
  proposal          KanbanProposal    @relation(fields: [proposalId], references: [id])
  article           Article           @relation(fields: [articleId], references: [id])

  @@index([proposalId])
  @@index([articleId])
}
